# Copia este archivo como .env y completa los datos de tu base en Neon (ver README.md)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=tu_contraseña_de_neon
# Clave para firmar los tokens (genérala con: openssl rand -base64 48)
TOKEN_JWT_SECRET=pon_aqui_una_clave_en_base64_de_al_menos_32_bytes
